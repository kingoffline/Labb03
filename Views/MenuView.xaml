<UserControl x:Class="L046_Labb3_Code_along.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="24" d:DesignWidth="780">
    <Menu>
        <Menu.Resources>
            <Style x:Key="MenuIconStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Menu.Resources>

        <MenuItem Header="_File">
            <MenuItem Header="_New Question Pack"
                      Command="{Binding NewPackCommand}"
                      InputGestureText="Ctrl+N">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE710;" />
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="_Select Question Pack"
                      ItemsSource="{Binding Packs}"
                      DisplayMemberPath="Name">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE8B7;" />
                </MenuItem.Icon>
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Command"
                                Value="{Binding DataContext.SelectPackCommand,
                                                RelativeSource={RelativeSource AncestorType=MenuItem}}" />
                        <Setter Property="CommandParameter" Value="{Binding}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>

            <MenuItem Header="_Delete Question Pack"
                      Command="{Binding DeletePackCommand}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE74D;" />
                </MenuItem.Icon>
            </MenuItem>

            <Separator />

            <MenuItem Header="_Import Questions..."
                      Command="{Binding ImportQuestionsCommand}"
                      InputGestureText="Ctrl+I">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE896;" />
                </MenuItem.Icon>
            </MenuItem>

            <Separator />

            <MenuItem Header="E_xit"
                      InputGestureText="Alt+F4"
                      Click="Exit_Click">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE7E8;" />
                </MenuItem.Icon>
            </MenuItem>
        </MenuItem>

        <MenuItem Header="_Edit">
            <MenuItem Header="_Add Question"
              Command="{Binding AddQuestionCommand}"
              InputGestureText="Insert">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE710;" />
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="_Remove Question"
              Command="{Binding RemoveQuestionCommand}"
              InputGestureText="Delete">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE738;" />
                </MenuItem.Icon>
            </MenuItem>

            <Separator />

            <MenuItem Header="_Pack Options"
              Command="{Binding PackOptionsCommand}"
              InputGestureText="Ctrl+O">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE9E9;" />
                </MenuItem.Icon>
            </MenuItem>
        </MenuItem>

        <MenuItem Header="_View">
            <MenuItem Header="_Play"
                      Click="Play_Click"
                      InputGestureText="Ctrl+P" />
            <MenuItem Header="_Edit"
                      Click="Edit_Click"
                      InputGestureText="Ctrl+E" />
            <Separator />
            <MenuItem Header="_Fullscreen"
                      InputGestureText="Alt+Enter"
                      Click="Fullscreen_Click" />
        </MenuItem>
    </Menu>
</UserControl>