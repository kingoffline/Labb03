<Window x:Class="L046_Labb3_Code_along.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:L046_Labb3_Code_along"
        xmlns:views="clr-namespace:L046_Labb3_Code_along.Views"
        mc:Ignorable="d"
        Title="Quiz Configurator" Height="490" Width="780"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="17*"/>
            <ColumnDefinition Width="178*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:MenuView Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,18"/>
        <views:ConfigurationView x:Name="ConfigurationViewControl" Grid.ColumnSpan="2" Margin="0,18,0,0" Grid.RowSpan="2" />
        <views:PlayerView x:Name="PlayerViewControl" Visibility="Collapsed" Grid.ColumnSpan="2" Margin="0,18,0,0" Grid.RowSpan="2" />
    </Grid>
</Window>
