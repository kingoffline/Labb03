<Window x:Class="L046_Labb3_Code_along.Dialogs.PackOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pack Options"
        Width="230"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Pack Name:"
                   FontWeight="Bold"
                   Margin="0,0,0,4" />

        <TextBox Grid.Row="1"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 Height="24"
                 Padding="4,2" />

        <TextBlock Grid.Row="2"
                   Text="Difficulty:"
                   FontWeight="Bold"
                   Margin="0,12,0,4" />

        <ComboBox Grid.Row="3"
                  ItemsSource="{Binding Difficulties}"
                  SelectedItem="{Binding Difficulty, Mode=TwoWay}"
                  Height="24" />

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="Time Limit:" FontWeight="Bold" />
            <TextBlock Text="{Binding TimeLimitText}"
                       HorizontalAlignment="Right" />
        </Grid>

        <Slider Grid.Row="5"
                Minimum="5"
                Maximum="120"
                TickFrequency="5"
                TickPlacement="BottomRight"
                IsSnapToTickEnabled="True"
                Value="{Binding TimeLimitInSeconds, Mode=TwoWay}"
                Margin="0,4,0,0" />

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    IsCancel="True"
                    Width="70" Height="24"
                    Margin="0,0,8,0" />
            <Button Content="Save"
                    IsDefault="True"
                    Width="70" Height="24"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>